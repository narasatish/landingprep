rules_version = '2';
// LandingPrep — Firestore security rules.
// Paste this into Firebase Console → Firestore → Rules → Publish.
//
// SECURITY MODEL:
//  - The CLIENT (browser Firebase SDK) may only touch the two public collections
//    below (questions, leaderboard): read is open, writes are shape-validated +
//    length-capped, and DELETE IS ALWAYS DENIED (allow delete: if false).
//  - Sensitive collections (accounts/users, reviews, newsletter, push subs, ig_*)
//    have NO rule here, so the final catch-all denies ALL client access to them.
//    The server reaches them via the Firebase Admin SDK, which bypasses these rules
//    by design — so user password hashes are never exposed to the browser.
//  - The explicit `match /{document=**}` deny at the bottom means any NEW collection
//    is closed by default until you deliberately open it. Fail-closed, not fail-open.
service cloud.firestore {
  match /databases/{database}/documents {

    match /questions/{id} {
      allow read: if true;
      allow create: if request.resource.data.title is string
                    && request.resource.data.title.size() >= 8
                    && request.resource.data.title.size() <= 140
                    && request.resource.data.body.size() <= 2000
                    && request.resource.data.author.size() <= 40;
      // Allow updates only to votes/answers (for upvotes and posting answers).
      allow update: if request.resource.data.title == resource.data.title;
      allow delete: if false;
    }

    match /leaderboard/{id} {
      allow read: if true;
      allow create: if request.resource.data.exam is string
                    && request.resource.data.exam.size() <= 20
                    && request.resource.data.name.size() <= 40
                    && request.resource.data.pct is number
                    && request.resource.data.pct >= 0
                    && request.resource.data.pct <= 100;
      allow update, delete: if false;
    }

    // FAIL-CLOSED CATCH-ALL — every collection not explicitly matched above is
    // fully denied to client SDKs (accounts, reviews, newsletter, push, ig_*, and
    // any collection added in future). The server's Admin SDK is unaffected.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
