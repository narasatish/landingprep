    {
      "id": "gre-quant-007-q08",
      "questionType": "problem_solving",
      "topic": "Problem Solving",
      "prompt": "Sofia can assemble a bookcase twice as fast as Marcus. Working together they finish one in 24 hours. How many hours would Sofia take alone?",
      "difficulty": "medium",
      "options": [
        "48",
        "24",
        "72",
        "36",
        "16"
      ],
      "correctAnswer": "36",
      "explanation": "Let Marcus's rate be r. Sofia's is 2r, so together (3)r = 1/24, giving r = 1/72. Sofia's rate 2r = 2/72 = 1/36, so Sofia alone takes 36 hours.",
