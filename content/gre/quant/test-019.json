      "id": "gre-quant-019-q09",
      "questionType": "problem_solving",
      "topic": "Problem Solving",
      "prompt": "Sofia can assemble a bookcase twice as fast as Marcus. Working together they finish one in 16 hours. How many hours would Sofia take alone?",
      "difficulty": "medium",
      "options": [
        "24",
        "11",
        "48",
        "16",
        "32"
