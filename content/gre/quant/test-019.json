      "questionType": "problem_solving",
      "topic": "Problem Solving",
      "prompt": "The ratio of blue to red marbles is 4 to 5. If 12 blue marbles are added, the ratio becomes 56 to 55. How many red marbles are there?",
      "difficulty": "medium",
      "options": [
        "44",
        "55",
        "43",
        "67",
        "56"
