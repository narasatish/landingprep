      "questionType": "problem_solving",
      "topic": "Problem Solving",
      "prompt": "Sofia can assemble a bookcase 3 times as fast as Marcus. Working together they finish one in 18 hours. How many hours would Sofia take alone?",
      "difficulty": "medium",
      "options": [
