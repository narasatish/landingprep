    "ielts": {
      "examId": "ielts",
      "examName": "IELTS",
      "fullName": "International English Language Testing System",
      "scale": "Band 1–9 (overall and per section)",
      "website": "https://www.ielts.org",

      "variants": [
        {
          "id": "academic",
          "label": "IELTS Academic",
          "description": "For undergraduate/postgraduate study and professional registration",
          "sections": ["listening", "reading", "writing", "speaking"]
        },
        {
          "id": "general_training",
          "label": "IELTS General Training",
          "description": "For secondary education, work experience and immigration to English-speaking countries",
          "sections": ["listening", "reading", "writing", "speaking"]
        }
      ],

      "sections": {

        "listening": {
          "id": "listening",
          "label": "Listening",
          "icon": "🎧",
          "rendererType": "ielts-listening",
          "durationMinutes": 30,
          "questionCount": 40,
          "sameForAllVariants": true,
          "structure": {
            "parts": 4,
            "questionsPerPart": 10,
            "partDescriptions": [
              "Part 1: Everyday social conversation between two speakers (form/note completion)",
              "Part 2: Monologue on everyday social topic (map/matching/multiple choice)",
              "Part 3: Academic discussion between 2–3 speakers (MCQ choose-two/matching)",
              "Part 4: Academic lecture monologue (note/summary/flowchart completion)"
            ]
          },
          "itemTypes": [
            "form_completion",
            "note_completion",
            "table_completion",
            "flowchart_completion",
            "summary_completion",
            "multiple_choice",
            "multiple_choice_choose_two",
            "matching",
            "map_labelling",
            "sentence_completion"
          ],
          "scriptWordsPerPart": { "min": 400, "max": 650 },
          "reviewRequirements": ["answer_key", "explanation", "transcript_after_submit"]
        },

        "reading": {
          "id": "reading",
          "label": "Reading",
          "icon": "📖",
          "rendererType": "ielts-reading",
          "durationMinutes": 60,
          "questionCount": 40,
          "variantDifferences": true,
          "variants": {
            "academic": {
              "structure": "3 long academic passages (each 900–1200 words), 40 questions total",
              "passageCount": 3,
              "passageWordRange": [900, 1200],
              "topics": "Academic, scientific, historical — adapted from books, journals, newspapers",
              "paragraphLabels": true
            },
            "general_training": {
              "structure": "3 sections of shorter texts (Section 1: notices/ads, Section 2: workplace, Section 3: general interest)",
              "passageCount": 3,
              "section1WordRange": [300, 450],
              "section2WordRange": [450, 600],
              "section3WordRange": [700, 900],
              "topics": "Everyday notices, workplace documents, general-interest articles"
            }
          },
          "itemTypes": [
            "matching_headings",
            "matching_information",
            "matching_features",
            "true_false_not_given",
            "yes_no_not_given",
            "sentence_completion",
            "summary_completion",
            "note_completion",
            "table_completion",
            "flowchart_completion",
            "multiple_choice",
            "short_answer"
          ],
          "uiLayout": "split-screen — passage sticky left, questions scroll right",
          "reviewRequirements": ["answer_key", "explanation", "passage_text"]
        },

        "writing": {
          "id": "writing",
          "label": "Writing",
          "icon": "✍️",
          "rendererType": "ielts-writing",
          "durationMinutes": 60,
          "questionCount": 2,
          "variantDifferences": true,
          "variants": {
            "academic": {
              "task1": {
                "label": "Task 1 — Describe a visual",
                "promptType": "chart/graph/table/map/process/diagram",
                "wordTarget": 150,
                "modelAnswerMinWords": 160,
                "requiresVisual": true,
                "visualTypes": ["line", "bar", "pie", "table", "process", "map"]
              },
              "task2": {
                "label": "Task 2 — Essay",
                "promptType": "essay (discuss both views / agree-disagree / problem-solution / two-part question)",
                "wordTarget": 250,
                "modelAnswerMinWords": 280
              }
            },
            "general_training": {
              "task1": {
                "label": "Task 1 — Letter",
                "promptType": "formal/semi-formal/informal letter",
                "wordTarget": 150,
                "modelAnswerMinWords": 160,
                "requiresVisual": false,
                "letterStyles": ["formal", "semi-formal", "informal"]
              },
              "task2": {
                "label": "Task 2 — Essay",
                "promptType": "essay (same as Academic Task 2)",
                "wordTarget": 250,
                "modelAnswerMinWords": 280
              }
            }
          },
          "reviewRequirements": ["model_answer", "rubric_breakdown", "word_count"]
        },

        "speaking": {
          "id": "speaking",
          "label": "Speaking",
          "icon": "🎤",
          "rendererType": "ielts-speaking",
          "durationMinutes": 15,
          "sameForAllVariants": true,
          "structure": {
            "parts": 3,
            "partDescriptions": [
              "Part 1: Introduction — 4–5 short personal questions (30 sec each)",
              "Part 2: Cue card — 1 min prep, 1–2 min response, 1 follow-up question",
              "Part 3: Discussion — 4–5 analytical questions (60–90 sec each)"
            ]
          },
          "questionCount": 9,
          "itemTypes": ["speaking_task"],
          "reviewRequirements": ["model_answer_per_question", "rubric", "feedback"]
        }
      },

      "fullMockStructure": {
        "sections": ["listening", "reading", "writing", "speaking"],
        "totalDurationMinutes": 165,
        "notes": "Listening 30 min, Reading 60 min, Writing 60 min, Speaking 11–14 min (separate appointment in real exam)"
      }
    },

