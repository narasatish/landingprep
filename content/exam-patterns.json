            "rhetorical_purpose",
            "vocabulary",
            "reference",
            "sentence_insertion",
            "prose_summary",
            "fill_in_table"
          ],
          "uiLayout": "passage with highlighted sentence insertion, prose-summary drag-drop at end",
          "reviewRequirements": ["answer_key", "explanation", "passage_context"]
        },

        "listening": {
          "id": "listening",
          "label": "Listening",
          "icon": "🎧",
          "rendererType": "toefl-listening",
          "durationMinutes": 36,
          "audioCount": 5,
          "structure": "2 conversations (2 min each) + 3 lectures (4–6 min each)",
          "questionsPerAudio": [5, 5, 6, 6, 6],
          "questionCount": 28,
          "itemTypes": [
            "gist_content",
            "gist_purpose",
            "detail",
            "function",
            "attitude",
            "organization",
            "connecting_content",
            "inference"
          ],
          "reviewRequirements": ["answer_key", "explanation", "audio_script_after_submit"]
        },

        "speaking": {
          "id": "speaking",
          "label": "Speaking",
          "icon": "🎤",
          "rendererType": "toefl-speaking",
          "durationMinutes": 16,
          "questionCount": 4,
          "structure": {
            "task1": "Independent: Express and support an opinion on a familiar topic (45 sec prep, 60 sec response)",
            "task2": "Integrated Reading+Listening: Campus situation (30 sec prep, 60 sec response)",
            "task3": "Integrated Reading+Listening: Academic course topic (30 sec prep, 60 sec response)",
            "task4": "Integrated Listening only: Academic lecture (20 sec prep, 60 sec response)"
          },
          "itemTypes": ["independent_speaking", "integrated_speaking"],
          "reviewRequirements": ["model_answer", "rubric", "reading_passage_if_applicable", "audio_script"]
        },

        "writing": {
          "id": "writing",
          "label": "Writing",
          "icon": "✍️",
          "rendererType": "toefl-writing",
          "durationMinutes": 29,
          "questionCount": 2,
          "structure": {
            "task1": "Integrated: Read passage (3 min) + Listen to lecture, then write 150–225 words (20 min)",
            "task2": "Academic Discussion: Respond to professor and two students' posts (150+ words, 10 min)"
          },
          "itemTypes": ["integrated_writing", "academic_discussion"],
          "reviewRequirements": ["model_answer", "source_passage", "audio_script"]
        }
      },

      "fullMockStructure": {
        "sections": ["reading", "listening", "speaking", "writing"],
        "totalDurationMinutes": 116
      }
    },

