      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-024-q011",
      "questionNumber": 11,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "A car travels at a constant 60 mph for 2.5 hours. How far does it travel?",
      "options": [
        "150 miles",
        "165 miles",
        "180 miles",
        "120 miles",
        "135 miles"
      ],
      "correctAnswer": "150 miles",
      "answer": "C",
      "explanation": "Distance = speed × time = 60 × 2.5 = 150 miles.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-024-q012",
      "questionNumber": 12,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "A 40-litre solution is 25% acid. How many litres of pure acid does it contain?",
      "options": [
        "8",
        "10",
