      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-023-q016",
      "questionNumber": 16,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "If 5 identical pens cost $20, how much do 8 of the same pens cost?",
      "options": [
        "$32",
        "$36",
        "$40",
        "$28",
        "$30"
      ],
      "correctAnswer": "$32",
      "answer": "C",
