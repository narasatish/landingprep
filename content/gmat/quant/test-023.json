      "questionNumber": 1,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "An item costing $50 is sold for $65. What is the profit percentage?",
      "options": [
        "30%",
        "35%",
        "15%",
        "20%",
        "25%"
      ],
      "correctAnswer": "30%",
      "answer": "D",
      "explanation": "Profit = 65 − 50 = 15. Profit % = 15 ÷ 50 = 30%.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-023-q002",
      "questionNumber": 2,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "What is the median of the set {3, 7, 9, 12, 15}?",
      "options": [
        "7",
        "9",
        "10",
        "11",
        "12"
      ],
      "correctAnswer": "9",
      "answer": "B",
      "explanation": "With 5 ordered values, the median is the 3rd value, which is 9.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-023-q003",
      "questionNumber": 3,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "If 3x = 18, what is the value of x² + x?",
      "options": [
        "36",
        "40",
        "42",
        "48",
        "54"
      ],
      "correctAnswer": "42",
      "answer": "C",
      "explanation": "x = 6. x² + x = 36 + 6 = 42.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-023-q004",
      "questionNumber": 4,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "A triangle has a base of 10 and a height of 6. What is its area?",
      "options": [
        "60",
        "24",
        "28",
        "30",
        "36"
      ],
      "correctAnswer": "30",
      "answer": "C",
      "explanation": "Area = ½ × base × height = ½ × 10 × 6 = 30.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-023-q005",
      "questionNumber": 5,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "A circle has radius 7. Using π = 22/7, what is its area?",
      "options": [
        "168",
        "176",
        "132",
        "144",
        "154"
      ],
      "correctAnswer": "154",
      "answer": "C",
      "explanation": "Area = πr² = (22/7) × 49 = 22 × 7 = 154.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-023-q006",
      "questionNumber": 6,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "A car consumes 8 litres of fuel per 100 km. How much fuel is needed for a 250 km trip?",
      "options": [
        "20 litres",
        "22 litres",
        "24 litres",
        "16 litres",
        "18 litres"
      ],
      "correctAnswer": "20 litres",
      "answer": "C",
      "explanation": "Fuel = 8 × (250 ÷ 100) = 8 × 2.5 = 20 litres.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-023-q007",
      "questionNumber": 7,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "What is the value of 5! (5 factorial)?",
      "options": [
        "100",
        "120",
        "150",
        "720",
        "60"
      ],
      "correctAnswer": "120",
      "answer": "C",
      "explanation": "5! = 5 × 4 × 3 × 2 × 1 = 120.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-023-q008",
      "questionNumber": 8,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "What is the least common multiple (LCM) of 4, 6, and 8?",
      "options": [
        "16",
        "20",
        "24",
        "48",
        "12"
      ],
      "correctAnswer": "24",
      "answer": "D",
      "explanation": "Multiples of 8: 8, 16, 24 … 24 is divisible by 4 and 6, so LCM = 24.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-023-q009",
      "questionNumber": 9,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "What is the greatest common divisor (GCD) of 24 and 36?",
      "options": [
        "24",
        "6",
        "8",
        "12",
        "18"
      ],
      "correctAnswer": "12",
      "answer": "C",
      "explanation": "24 = 12 × 2, 36 = 12 × 3. The largest common factor is 12.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-023-q010",
      "questionNumber": 10,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "Three-quarters of a number is 60. What is the number?",
      "options": [
        "85",
        "90",
        "70",
        "75",
        "80"
      ],
      "correctAnswer": "80",
      "answer": "C",
      "explanation": "(3/4)x = 60 → x = 60 × 4 ÷ 3 = 80.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-023-q011",
      "questionNumber": 11,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "If a : b = 2 : 3 and b : c = 4 : 5, what is a : c?",
      "options": [
        "8 : 15",
        "6 : 5",
        "3 : 5",
        "8 : 5",
        "2 : 5"
      ],
      "correctAnswer": "8 : 15",
      "answer": "B",
      "explanation": "Make b common: a:b = 8:12, b:c = 12:15. So a:c = 8:15.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-023-q012",
      "questionNumber": 12,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "A rectangular box measures 2 × 3 × 4. What is its volume?",
