    },
    {
      "id": "gmat-quant-023-q017",
      "questionNumber": 17,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "A tank is 3/5 full. Adding 20 litres makes it 4/5 full. What is the tank's total capacity?",
      "options": [
        "90 litres",
        "100 litres",
        "110 litres",
        "120 litres",
        "80 litres"
      ],
      "correctAnswer": "100 litres",
      "answer": "C",
