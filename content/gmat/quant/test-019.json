      "questionNumber": 4,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "If 12 men finish a job in 10 days, how many men are needed to finish it in 8 days?",
      "options": [
        "13",
        "14",
        "15",
        "16",
        "18"
      ],
      "correctAnswer": "15",
      "answer": "C",
      "explanation": "Work = 12 × 10 = 120 man-days. For 8 days: 120 ÷ 8 = 15 men.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-019-q005",
      "questionNumber": 5,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "An item costing $50 is sold for $65. What is the profit percentage?",
      "options": [
        "15%",
        "20%",
        "25%",
        "30%",
        "35%"
