      "correctAnswer": "30%",
      "answer": "D",
      "explanation": "Profit = 65 − 50 = 15. Profit % = 15 ÷ 50 = 30%.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-019-q006",
      "questionNumber": 6,
      "questionType": "problem_solving",
      "section": "quant",
