    },
    {
      "id": "gmat-quant-007-q010",
      "questionNumber": 10,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "A bag holds 3 red and 2 blue marbles. If one marble is drawn at random, what is the probability it is red?",
      "options": [
        "2/3",
        "1/5",
        "2/5",
        "1/2",
        "3/5"
      ],
      "correctAnswer": "3/5",
      "answer": "E",
      "explanation": "P(red) = favourable ÷ total = 3 ÷ (3 + 2) = 3/5.",
      "difficulty": "medium"
