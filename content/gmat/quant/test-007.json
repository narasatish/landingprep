      "questionNumber": 1,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "The average of 5 numbers is 20. If the number 40 is removed, what is the average of the remaining 4 numbers?",
      "options": [
        "15",
        "16",
        "18",
        "20",
        "12"
      ],
      "correctAnswer": "15",
      "answer": "A",
      "explanation": "Sum of 5 = 5 × 20 = 100. Remove 40 → 60 left over 4 numbers. Average = 60 ÷ 4 = 15.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-007-q002",
      "questionNumber": 2,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "Two amounts are in the ratio 3 : 5 and total 64. What is the difference between them?",
      "options": [
        "12",
        "16",
        "20",
        "24",
        "8"
      ],
      "correctAnswer": "16",
      "answer": "B",
      "explanation": "Parts = 3 + 5 = 8 → each part = 64 ÷ 8 = 8. Amounts: 24 and 40. Difference = 40 − 24 = 16.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-007-q003",
      "questionNumber": 3,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "A rectangle has length 12 and width 8. What is the sum of its area and perimeter?",
      "options": [
        "96",
        "120",
        "136",
        "140",
        "152"
      ],
      "correctAnswer": "136",
      "answer": "C",
      "explanation": "Area = 12 × 8 = 96. Perimeter = 2(12 + 8) = 40. Sum = 96 + 40 = 136.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-007-q004",
      "questionNumber": 4,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "What is the value of 2^5 × 2^3?",
      "options": [
        "1024",
        "64",
        "128",
        "256",
        "512"
      ],
      "correctAnswer": "256",
      "answer": "D",
      "explanation": "2^5 × 2^3 = 2^(5+3) = 2^8 = 256.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-007-q005",
      "questionNumber": 5,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "If x + y = 10 and x − y = 4, what is the value of xy?",
      "options": [
        "24",
        "27",
        "30",
        "18",
        "21"
      ],
      "correctAnswer": "21",
      "answer": "E",
      "explanation": "Adding: 2x = 14 → x = 7. Then y = 3. xy = 7 × 3 = 21.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-007-q006",
      "questionNumber": 6,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "What is 15% of 15% of 400?",
      "options": [
        "9",
        "12",
        "15",
        "18",
        "6"
      ],
      "correctAnswer": "9",
      "answer": "A",
      "explanation": "15% of 400 = 60. 15% of 60 = 9.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-007-q007",
      "questionNumber": 7,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "A shirt is marked $80. It is discounted 25%, then 5% sales tax is added. What is the final price?",
      "options": [
        "$60",
        "$63",
        "$66",
        "$70",
        "$57"
