        "120 miles",
        "135 miles",
        "150 miles",
        "165 miles",
        "180 miles"
      ],
      "correctAnswer": "150 miles",
      "answer": "C",
      "explanation": "Distance = speed × time = 60 × 2.5 = 150 miles.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-007-q009",
      "questionNumber": 9,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "A 40-litre solution is 25% acid. How many litres of pure acid does it contain?",
      "options": [
        "15",
        "16",
        "8",
        "10",
        "12"
      ],
      "correctAnswer": "10",
      "answer": "D",
      "explanation": "Acid = 25% of 40 = 0.25 × 40 = 10 litres.",
