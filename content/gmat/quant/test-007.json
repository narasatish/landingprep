      "correctAnswer": "$63",
      "answer": "B",
      "explanation": "Discount: 80 × 0.75 = 60. Tax: 60 × 1.05 = 63.",
      "difficulty": "medium"
    },
    {
      "id": "gmat-quant-007-q008",
      "questionNumber": 8,
      "questionType": "problem_solving",
      "section": "quant",
      "prompt": "A car travels at a constant 60 mph for 2.5 hours. How far does it travel?",
