# LandingPrep — nginx reverse-proxy config for the Hostinger VPS.
# 1) Save as /etc/nginx/sites-available/landingprep, then:
#      ln -s /etc/nginx/sites-available/landingprep /etc/nginx/sites-enabled/
#      nginx -t && systemctl reload nginx
# 2) Get free HTTPS:
#      apt install certbot python3-certbot-nginx
#      certbot --nginx -d landingprep.com -d www.landingprep.com
#    (certbot rewrites this file to add the SSL block and the 80->443 redirect.)
# 3) Make sure the Node app is running on 127.0.0.1:3001 (pm2 — see ecosystem.config.cjs).

server {
    listen 80;
    server_name landingprep.com www.landingprep.com;

    # Redirect www -> non-www (canonical)
    if ($host = www.landingprep.com) { return 301 https://landingprep.com$request_uri; }

    client_max_body_size 2m;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain application/xml;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Allow Server-Sent Events (AI tutor streaming)
        proxy_buffering off;
        proxy_read_timeout 300s;
    }
}
