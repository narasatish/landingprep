{
  "name": "landingprep-server",
  "version": "1.0.0",
  "description": "LandingPrep backend API — Gemini proxy + static serving",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seo": "node scripts/generate-seo-pages.mjs",
    "precompile": "node scripts/precompile-jsx.mjs",
    "build": "node scripts/precompile-jsx.mjs && node scripts/generate-seo-pages.mjs",
    "test": "node tools/run-tests.js && node tools/exam-validation.mjs",
    "test:exams": "node tools/exam-validation.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.7.0",
    "nodemailer": "^8.0.10"
  },
  "devDependencies": {
    "esbuild": "^0.28.0"
  }
}
